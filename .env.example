# Copy to .env.local and fill in values. See README for descriptions.

# Gemini (required for audit)
GEMINI_API_KEY=

# Groq (optional final fallback after Gemini failures)
GROQ_API_KEY=

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PRIVATE_SERVICE_ROLE_API_KEY=

# Discord webhook (required for approval flow)
DISCORD_WEBHOOK_URL=

# Floating contact widget (optional; FAB always visible, links need these)
# NEXT_PUBLIC_CONTACT_WHATSAPP=1234567890
# NEXT_PUBLIC_CONTACT_EMAIL=hello@example.com

# Google Search Console (optional; for SEO tracking – add verification code from GSC)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-verification-code

# Optional provider overrides
# GEMINI_MODEL=gemini-3.1-flash-lite
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_MODEL=llama-3.3-70b-versatile
NEXT_PUBLIC_SITE_URL=http://localhost:3000
